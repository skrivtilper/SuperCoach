# Upstream secrets. Never commit real values.
INTERVALS_API_KEY=
GITHUB_TOKEN=

# Bound GitHub scope for the single-user coach.
GITHUB_ALLOWED_OWNER=skrivtilper
GITHUB_ALLOWED_REPO=SuperCoachPersistent

# Optional upstream overrides.
INTERVALS_BASE_URL=https://intervals.icu
GITHUB_API_BASE_URL=https://api.github.com

# MCP transport security:
# For local/private testing, set a long random bearer token.
MCP_BEARER_TOKEN=
# Or set true ONLY when an authenticated reverse proxy/tunnel/OAuth layer protects /mcp.
ALLOW_UNAUTHENTICATED=false

PORT=3000
HOST=0.0.0.0
REQUEST_TIMEOUT_MS=30000
